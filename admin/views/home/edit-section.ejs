<div class="panel panel-inverse">
  <div class="panel-heading"><h4 class="panel-title"><%= pageTitle %></h4></div>
  <div class="panel-body">
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <% if (section.type === 'categories') { %>
      <div class="alert alert-info">
        The cards in this section are generated from
        <a href="/admin/product-categories">Product Categories</a>: each category's picture, name and sort order,
        limited to categories with "Show on home page" checked.
        The HTML below must keep the <code><%= categoriesPlaceholder %></code> marker where the cards are inserted.
      </div>
      <% if (homeCategories.length) { %>
        <div class="d-flex flex-wrap gap-2 mb-3">
          <% homeCategories.forEach(function(category) { %>
            <a href="/admin/product-categories/<%= category.slug %>/edit" class="text-center text-decoration-none" style="width:110px">
              <% if (category.image) { %>
                <img src="<%= category.image %>" alt="" style="width:110px;height:80px;object-fit:cover;border:1px solid #ddd">
              <% } else { %>
                <div style="width:110px;height:80px;border:1px dashed #ccc;line-height:80px;color:#999">No picture</div>
              <% } %>
              <small class="d-block"><%= category.name %></small>
            </a>
          <% }) %>
        </div>
      <% } %>
    <% } else if (section.html.indexOf(newsPlaceholder) !== -1) { %>
      <div class="alert alert-info">
        The latest published <a href="/admin/news">News</a> items are inserted where the
        <code><%= newsPlaceholder %></code> marker is. Keep the marker in the HTML.
      </div>
    <% } %>

    <form method="post" action="/admin/home/<%= section.key %>/edit">
      <div class="mb-3">
        <label class="form-check">
          <input type="checkbox" class="form-check-input" name="enabled" value="1" <%= section.enabled !== false ? 'checked' : '' %>>
          Show this section on the home page
        </label>
      </div>
      <div class="mb-3">
        <label class="form-label">HTML</label>
        <textarea class="rich-text" name="content" data-editor-mode="source"><%= section.html %></textarea>
      </div>
      <button class="btn btn-primary" type="submit">Save</button>
      <a class="btn btn-secondary" href="/admin/home">Cancel</a>
    </form>
  </div>
</div>
