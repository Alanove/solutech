<div class="panel panel-inverse">
  <div class="panel-heading">
    <h4 class="panel-title">Home Page sections</h4>
    <div class="panel-heading-btn">
      <a href="/" target="_blank" class="btn btn-xs btn-default">View home page</a>
    </div>
  </div>
  <div class="panel-body">
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <% if (missing) { %>
      <div class="alert alert-warning">
        Home sections have not been created yet. Run <code>node scripts/split-home-sections.js</code> to split the current home page into sections.
      </div>
    <% } else { %>
      <p class="text-muted">This screen edits the home page content blocks, shown in this order. The top banner is managed under <a href="/admin/slider">Slider</a> (the Hero section below is only used when there are no active slides). Title and SEO settings are edited on the <a href="/admin/pages/home/edit">Home page settings</a>.</p>
      <table class="table table-striped">
        <thead><tr><th>#</th><th>Section</th><th>Type</th><th>Visible</th><th>Last updated</th><th></th></tr></thead>
        <tbody>
          <% sections.forEach(function(section, index) { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= section.label %></td>
              <td>
                <% if (section.type === 'categories') { %>
                  <span class="badge bg-info">Dynamic: Product Categories</span>
                <% } else if (section.html.indexOf('<!--SOLU_NEWS-->') !== -1) { %>
                  <span class="badge bg-info">HTML + latest news</span>
                <% } else { %>
                  <span class="badge bg-secondary">HTML</span>
                <% } %>
              </td>
              <td><%= section.enabled !== false ? 'Yes' : 'No' %></td>
              <td><%= section.lastUpdated ? new Date(section.lastUpdated).toLocaleString() : '' %></td>
              <td><a class="btn btn-xs btn-primary" href="/admin/home/<%= section.key %>/edit">Edit</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
