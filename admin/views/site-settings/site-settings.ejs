<!-- BEGIN breadcrumb -->
<ol class="breadcrumb">
	<li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
	<li class="breadcrumb-item active">Site Settings</li>
</ol>
<!-- END breadcrumb -->

<form method="POST" action="/admin/site-settings/update" enctype="multipart/form-data" id="siteSettingsForm">
	<!-- BEGIN row -->
	<div class="row">
		<!-- BEGIN col-9 -->
		<div class="col-xl-9">
			<!-- BEGIN panel - Basic Information -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-1">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">Basic Information</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<% if (typeof error !=='undefined' && error) { %>
						<div class="alert alert-danger">
							<i class="fa fa-exclamation-triangle"></i>
							<%= error %>
						</div>
					<% } %>
					<% if (typeof success !=='undefined' && success) { %>
						<div class="alert alert-success">
							<i class="fa fa-check-circle"></i>
							<%= success %>
						</div>
					<% } %>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Site Title <span class="text-danger">*</span></label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="siteTitle" name="siteTitle"
								value="<%= settings.siteTitle %>" required />
							<small class="fs-12px text-gray-500-darker">The main title of your website</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Site Description</label>
						<div class="col-md-9">
							<textarea class="form-control" id="siteDescription" name="siteDescription" rows="3"
								placeholder="Enter a brief description of your website..."><%= settings.siteDescription || '' %></textarea>
							<small class="fs-12px text-gray-500-darker">A brief description of your website for search engines</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Site URL</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="siteUrl" name="siteUrl"
								value="<%= settings.siteUrl %>" />
							<small class="fs-12px text-gray-500-darker">The main URL of your website (e.g., https://example.com)</small>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Contact Information -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-2">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">Contact Information</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Contact Email</label>
						<div class="col-md-9">
							<input type="email" class="form-control" id="contactEmail" name="contactEmail"
								value="<%= settings.contactEmail %>" />
							<small class="fs-12px text-gray-500-darker">Primary contact email address</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Careers Email</label>
						<div class="col-md-9">
							<input type="email" class="form-control" id="careersEmail" name="careersEmail"
								value="<%= settings.careersEmail || '' %>" />
							<small class="fs-12px text-gray-500-darker">Email address for career applications</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Contact Phone</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="contactPhone" name="contactPhone"
								value="<%= settings.contactPhone %>" />
							<small class="fs-12px text-gray-500-darker">Primary contact phone number</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Fax</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="fax" name="fax"
								value="<%= settings.fax || '' %>" />
						</div>
					</div>
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Location label</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="locationLabel" name="locationLabel"
								value="<%= settings.locationLabel || '' %>" />
						</div>
					</div>
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Parking note</label>
						<div class="col-md-9">
							<textarea class="form-control" id="parkingNote" name="parkingNote" rows="2"><%= settings.parkingNote || '' %></textarea>
						</div>
					</div>
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Address</label>
						<div class="col-md-9">
							<textarea class="form-control" id="address" name="address" rows="2"
								placeholder="Enter your business address..."><%= settings.address || '' %></textarea>
							<small class="fs-12px text-gray-500-darker">Your business or office address</small>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<div class="panel panel-inverse">
				<div class="panel-heading">
					<h4 class="panel-title">Portals, routing and Investia</h4>
				</div>
				<div class="panel-body">
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Portal CTA caption</label>
						<div class="col-md-9">
							<input type="text" class="form-control" name="portalCtaCaption" value="<%= settings.portalCtaCaption || '' %>">
							<small class="text-muted">Shown when a company portal URL is filled. Hidden when the URL is empty.</small>
						</div>
					</div>
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Privacy policy URL</label>
						<div class="col-md-9">
							<input type="url" class="form-control" name="privacyPolicyUrl" value="<%= settings.privacyPolicyUrl || '' %>">
						</div>
					</div>
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Investia disclaimer</label>
						<div class="col-md-9">
							<textarea class="form-control" name="investiaDisclaimer" rows="8"><%= settings.investiaDisclaimer || '' %></textarea>
							<small class="text-muted">Shown in the footer on Home, Wealth and Insure.</small>
						</div>
					</div>
					<p class="text-muted">Contact form “Your Concern” emails. Leave empty to use the site contact email.</p>
					<div class="row mb-2">
						<label class="form-label col-form-label col-md-3">Advisory</label>
						<div class="col-md-9"><input type="email" class="form-control" name="concernEmailAdvisory" value="<%= (settings.concernEmails && settings.concernEmails.advisory) || '' %>"></div>
					</div>
					<div class="row mb-2">
						<label class="form-label col-form-label col-md-3">Taxes</label>
						<div class="col-md-9"><input type="email" class="form-control" name="concernEmailTaxes" value="<%= (settings.concernEmails && settings.concernEmails.taxes) || '' %>"></div>
					</div>
					<div class="row mb-2">
						<label class="form-label col-form-label col-md-3">Bookkeeping</label>
						<div class="col-md-9"><input type="email" class="form-control" name="concernEmailBookkeeping" value="<%= (settings.concernEmails && settings.concernEmails.bookkeeping) || '' %>"></div>
					</div>
					<div class="row mb-2">
						<label class="form-label col-form-label col-md-3">Wealth</label>
						<div class="col-md-9"><input type="email" class="form-control" name="concernEmailWealth" value="<%= (settings.concernEmails && settings.concernEmails['wealth-management']) || '' %>"></div>
					</div>
					<div class="row mb-3">
						<label class="form-label col-form-label col-md-3">Insure</label>
						<div class="col-md-9"><input type="email" class="form-control" name="concernEmailInsure" value="<%= (settings.concernEmails && settings.concernEmails['income-replacement']) || '' %>"></div>
					</div>
				</div>
			</div>

			<!-- BEGIN panel - Office Locations -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-contact-locations">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">Office Locations</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<p class="mb-3">Manage multiple office locations that will appear on the contact page map and contact information section.</p>
					
					<div id="officeLocationsList">
						<!-- Office locations will be dynamically loaded here -->
					</div>
					
					<div class="mt-3">
						<button type="button" class="btn btn-primary" id="addOfficeLocationBtn">
							<i class="fa fa-plus"></i> Add New Location
						</button>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Social Media -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-3">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">Social Media</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Facebook</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="facebook" name="facebook"
								value="<%= settings.socialMedia.facebook %>" placeholder="https://facebook.com/yourpage" />
							<small class="fs-12px text-gray-500-darker">Your Facebook page URL</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">X (Twitter)</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="twitter" name="twitter"
								value="<%= settings.socialMedia.twitter %>" placeholder="https://x.com/yourhandle" />
							<small class="fs-12px text-gray-500-darker">Your X profile URL</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Instagram</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="instagram" name="instagram"
								value="<%= settings.socialMedia.instagram %>" placeholder="https://instagram.com/yourprofile" />
							<small class="fs-12px text-gray-500-darker">Your Instagram profile URL</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">LinkedIn</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="linkedin" name="linkedin"
								value="<%= settings.socialMedia.linkedin %>" placeholder="https://linkedin.com/company/yourcompany" />
							<small class="fs-12px text-gray-500-darker">Your LinkedIn company page URL</small>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - SEO Settings -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-4">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">SEO Settings</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Default Title</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="defaultTitle" name="defaultTitle"
								value="<%= settings.seo.defaultTitle %>" maxlength="60" />
							<div class="character-count" id="defaultTitleCount">0/60</div>
							<small class="fs-12px text-gray-500-darker">Default page title for SEO (max 60 characters)</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Default Description</label>
						<div class="col-md-9">
							<textarea class="form-control" id="defaultDescription" name="defaultDescription" rows="3"
								maxlength="160" placeholder="Enter default meta description..."><%= settings.seo.defaultDescription || '' %></textarea>
							<div class="character-count" id="defaultDescriptionCount">0/160</div>
							<small class="fs-12px text-gray-500-darker">Default meta description for SEO (max 160 characters)</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Default Keywords</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="defaultKeywords" name="defaultKeywords"
								value="<%= settings.seo.defaultKeywords %>" />
							<small class="fs-12px text-gray-500-darker">Default keywords for SEO (comma-separated)</small>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Success Indicators -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-5">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">Success Indicators</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Total Projects</label>
						<div class="col-md-9">
							<input type="number" class="form-control" id="successTotalProjects" name="successTotalProjects"
								value="<%= settings.successIndicators && settings.successIndicators.totalProjects ? settings.successIndicators.totalProjects : '' %>" min="0" />
							<small class="fs-12px text-gray-500-darker">Override total projects count (leave empty to use calculated value from projects)</small>
							<div class="form-check mt-2">
								<input class="form-check-input" type="checkbox" id="successTotalProjectsShowPlus" name="successTotalProjectsShowPlus"
									<%= settings.successIndicators && settings.successIndicators.totalProjectsShowPlus ? 'checked' : '' %> />
								<label class="form-check-label" for="successTotalProjectsShowPlus">
									Show "+" icon after number
								</label>
							</div>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Total Countries</label>
						<div class="col-md-9">
							<input type="number" class="form-control" id="successTotalCountries" name="successTotalCountries"
								value="<%= settings.successIndicators && settings.successIndicators.totalCountries ? settings.successIndicators.totalCountries : '' %>" min="0" />
							<small class="fs-12px text-gray-500-darker">Override total countries count (leave empty to use calculated value from projects)</small>
							<div class="form-check mt-2">
								<input class="form-check-input" type="checkbox" id="successTotalCountriesShowPlus" name="successTotalCountriesShowPlus"
									<%= settings.successIndicators && settings.successIndicators.totalCountriesShowPlus ? 'checked' : '' %> />
								<label class="form-check-label" for="successTotalCountriesShowPlus">
									Show "+" icon after number
								</label>
							</div>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Specialists <span class="text-danger">*</span></label>
						<div class="col-md-9">
							<input type="number" class="form-control" id="successSpecialists" name="successSpecialists"
								value="<%= settings.successIndicators && settings.successIndicators.specialists ? settings.successIndicators.specialists : '48' %>" min="0" required />
							<small class="fs-12px text-gray-500-darker">Number of specialists</small>
							<div class="form-check mt-2">
								<input class="form-check-input" type="checkbox" id="successSpecialistsShowPlus" name="successSpecialistsShowPlus"
									<%= settings.successIndicators && settings.successIndicators.specialistsShowPlus ? 'checked' : '' %> />
								<label class="form-check-label" for="successSpecialistsShowPlus">
									Show "+" icon after number
								</label>
							</div>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Specialists Sublabel</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="successSpecialistsSublabel" name="successSpecialistsSublabel"
								value="<%= settings.successIndicators && settings.successIndicators.specialistsSublabel ? settings.successIndicators.specialistsSublabel : 'Beirut - Cairo - Riyadh' %>" />
							<small class="fs-12px text-gray-500-darker">Text displayed below specialists count (e.g., "Beirut - Cairo - Riyadh")</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Total Clients</label>
						<div class="col-md-9">
							<input type="number" class="form-control" id="successTotalClients" name="successTotalClients"
								value="<%= settings.successIndicators && settings.successIndicators.totalClients ? settings.successIndicators.totalClients : '' %>" min="0" />
							<small class="fs-12px text-gray-500-darker">Override total clients count (leave empty to use calculated value from clients)</small>
							<div class="form-check mt-2">
								<input class="form-check-input" type="checkbox" id="successTotalClientsShowPlus" name="successTotalClientsShowPlus"
									<%= settings.successIndicators && settings.successIndicators.totalClientsShowPlus ? 'checked' : '' %> />
								<label class="form-check-label" for="successTotalClientsShowPlus">
									Show "+" icon after number
								</label>
							</div>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->


		</div>
		<!-- END col-9 -->

		<!-- BEGIN col-3 -->
		<div class="col-xl-3">
			<!-- BEGIN panel - Images -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-6">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">Images</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<!-- Logo -->
					<div class="mb-15px">
						<label class="form-label">Logo</label>
						<div class="image-upload-container">
							<div class="image-preview" id="logoPreview">
								<img src="<%= settings.logo %>" alt="Logo" class="img-fluid" style="max-height: 100px;" />
							</div>
							<input type="file" class="form-control" id="logoFile" name="logoFile" accept="image/*" />
							<small class="fs-12px text-gray-500-darker">Upload your company logo (recommended: 200x100px)</small>
							<% if (settings.logo && settings.logo !== '/images/logo.jpg') { %>
								<button type="button" class="btn btn-sm btn-danger mt-2" onclick="deleteImage('logo')">
									<i class="fa fa-trash"></i> Delete Logo
								</button>
							<% } %>
						</div>
					</div>

					<div class="mb-15px">
						<label class="form-label">Footer Logo</label>
						<div class="image-upload-container">
							<div class="image-preview">
								<% if (settings.footerLogo) { %>
									<img src="<%= settings.footerLogo %>" alt="Footer logo" class="img-fluid" style="max-height: 100px;" />
								<% } %>
							</div>
							<input type="file" class="form-control" id="footerLogoFile" name="footerLogoFile" accept="image/*" />
						</div>
					</div>

					<!-- Favicon -->
					<div class="mb-15px">
						<label class="form-label">Favicon</label>
						<div class="image-upload-container">
							<div class="image-preview" id="faviconPreview">
								<img src="<%= settings.favicon %>" alt="Favicon" class="img-fluid" style="max-height: 32px;" />
							</div>
							<input type="file" class="form-control" id="faviconFile" name="faviconFile" accept="image/*" />
							<small class="fs-12px text-gray-500-darker">Upload your favicon (recommended: 32x32px)</small>
							<% if (settings.favicon && settings.favicon !== '/images/favicon.ico') { %>
								<button type="button" class="btn btn-sm btn-danger mt-2" onclick="deleteImage('favicon')">
									<i class="fa fa-trash"></i> Delete Favicon
								</button>
							<% } %>
						</div>
					</div>

					<!-- Site Image -->
					<div class="mb-15px">
						<label class="form-label">Site Image</label>
						<div class="image-upload-container">
							<div class="image-preview" id="siteImagePreview">
								<% if (settings.siteImage) { %>
									<img src="<%= settings.siteImage %>" alt="Site Image" class="img-fluid" style="max-height: 150px;" />
								<% } else { %>
									<div class="placeholder-image">No image uploaded</div>
								<% } %>
							</div>
							<input type="file" class="form-control" id="siteImageFile" name="siteImageFile" accept="image/*" />
							<small class="fs-12px text-gray-500-darker">Upload a general site image (recommended: 1200x630px)</small>
							<% if (settings.siteImage && settings.siteImage !== '/images/site-image.jpg') { %>
								<button type="button" class="btn btn-sm btn-danger mt-2" onclick="deleteImage('siteImage')">
									<i class="fa fa-trash"></i> Delete Site Image
								</button>
							<% } %>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Actions -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-7">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">Actions</h4>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<button type="submit" class="btn btn-primary btn-lg w-100 mb-2">
						<i class="fa fa-save"></i> Save All Settings
					</button>
					<a href="/admin/dashboard" class="btn btn-default btn-lg w-100">
						<i class="fa fa-arrow-left"></i> Back to Dashboard
					</a>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->
		</div>
		<!-- END col-3 -->
	</div>
	<!-- END row -->
</form>

<script>
// Office Locations Management
(function() {
	const officeLocationsList = document.getElementById('officeLocationsList');
	const addOfficeLocationBtn = document.getElementById('addOfficeLocationBtn');
	let officeLocations = <%- typeof contactInfo !== 'undefined' ? JSON.stringify(contactInfo) : '[]' %>;

	// Render office locations
	function renderOfficeLocations() {
		if (officeLocations.length === 0) {
			officeLocationsList.innerHTML = '<p class="text-muted">No office locations added yet. Click "Add New Location" to get started.</p>';
			return;
		}

		officeLocationsList.innerHTML = officeLocations.map((office, index) => `
			<div class="card mb-3 office-location-card" data-id="${office.id}">
				<div class="card-header d-flex justify-content-between align-items-center">
					<h5 class="mb-0">${office.city}, ${office.country}</h5>
					<button type="button" class="btn btn-sm btn-danger" onclick="deleteOfficeLocation('${office.id}')">
						<i class="fa fa-trash"></i> Delete
					</button>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-md-6 mb-3">
							<label class="form-label">Country</label>
							<input type="text" class="form-control office-country" value="${office.country || ''}" 
								onchange="updateOfficeLocation('${office.id}', 'country', this.value)">
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label">City</label>
							<input type="text" class="form-control office-city" value="${office.city || ''}" 
								onchange="updateOfficeLocation('${office.id}', 'city', this.value)">
						</div>
						<div class="col-md-12 mb-3">
							<label class="form-label">Address</label>
							<textarea class="form-control office-address" rows="2" 
								onchange="updateOfficeLocation('${office.id}', 'address', this.value)">${office.address || ''}</textarea>
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label">Phone</label>
							<input type="text" class="form-control office-phone" value="${office.phone || ''}" 
								onchange="updateOfficeLocation('${office.id}', 'phone', this.value)">
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label">WhatsApp Number</label>
							<input type="text" class="form-control office-whatsapp" value="${office.whatsappNumber || ''}" 
								placeholder="e.g., +971 54 421 1769"
								onchange="updateOfficeLocation('${office.id}', 'whatsappNumber', this.value)">
							<small class="form-text text-muted">Optional: WhatsApp number for this location</small>
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label">Email</label>
							<input type="email" class="form-control office-email" value="${office.email || ''}" 
								placeholder="e.g., office@example.com"
								onchange="updateOfficeLocation('${office.id}', 'email', this.value)">
							<small class="form-text text-muted">Optional: Email address for this location</small>
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label">Coordinates (lat,lng)</label>
							<input type="text" class="form-control office-coordinates" value="${office.coordinates || ''}" 
								placeholder="e.g., 33.8969865,35.5462693"
								onchange="updateOfficeLocation('${office.id}', 'coordinates', this.value)">
							<small class="form-text text-muted">Format: latitude,longitude (e.g., 33.8969865,35.5462693)</small>
						</div>
					</div>
				</div>
			</div>
		`).join('');
	}

	// Add new office location
	addOfficeLocationBtn.addEventListener('click', function() {
		const newOffice = {
			id: Date.now().toString(),
			country: '',
			city: '',
			address: '',
			phone: '',
			whatsappNumber: '',
			email: '',
			coordinates: ''
		};

		fetch('/admin/api/contact-info', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
			},
			body: JSON.stringify(newOffice)
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				officeLocations.push(data.data);
				renderOfficeLocations();
				showNotification('Office location added successfully', 'success');
			} else {
				showNotification('Failed to add office location: ' + (data.error || 'Unknown error'), 'error');
			}
		})
		.catch(error => {
			console.error('Error:', error);
			showNotification('Failed to add office location', 'error');
		});
	});

	// Update office location
	window.updateOfficeLocation = function(id, field, value) {
		const office = officeLocations.find(o => o.id === id);
		if (!office) return;

		office[field] = value;

		fetch(`/admin/api/contact-info/${id}`, {
			method: 'PUT',
			headers: {
				'Content-Type': 'application/json',
			},
			body: JSON.stringify(office)
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				const index = officeLocations.findIndex(o => o.id === id);
				if (index !== -1) {
					officeLocations[index] = data.data;
				}
				showNotification('Office location updated successfully', 'success');
			} else {
				showNotification('Failed to update office location: ' + (data.error || 'Unknown error'), 'error');
			}
		})
		.catch(error => {
			console.error('Error:', error);
			showNotification('Failed to update office location', 'error');
		});
	};

	// Delete office location
	window.deleteOfficeLocation = function(id) {
		if (!confirm('Are you sure you want to delete this office location?')) {
			return;
		}

		fetch(`/admin/api/contact-info/${id}`, {
			method: 'DELETE'
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				officeLocations = officeLocations.filter(o => o.id !== id);
				renderOfficeLocations();
				showNotification('Office location deleted successfully', 'success');
			} else {
				showNotification('Failed to delete office location: ' + (data.error || 'Unknown error'), 'error');
			}
		})
		.catch(error => {
			console.error('Error:', error);
			showNotification('Failed to delete office location', 'error');
		});
	};

	// Show notification
	function showNotification(message, type) {
		const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
		const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle';
		const alert = document.createElement('div');
		alert.className = `alert ${alertClass} alert-dismissible fade show`;
		alert.style.position = 'fixed';
		alert.style.top = '20px';
		alert.style.right = '20px';
		alert.style.zIndex = '9999';
		alert.style.minWidth = '300px';
		alert.innerHTML = `
			<i class="fa ${icon}"></i> ${message}
			<button type="button" class="close" data-dismiss="alert" aria-label="Close">
				<span aria-hidden="true">&times;</span>
			</button>
		`;
		document.body.appendChild(alert);
		setTimeout(() => {
			if (alert.parentNode) {
				alert.remove();
			}
		}, 3000);
	}

	// Initial render
	renderOfficeLocations();
})();
</script> 