	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Add Menu Item</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<form id="addMenuItemForm">
					<div class="mb-3">
						<label for="parentItem" class="form-label">Parent Item (Optional)</label>
						<select class="form-select" id="parentItem">
							<option value="">No Parent (Top Level)</option>
						</select>
					</div>
					
					<div class="mb-3">
						<label for="itemType" class="form-label">Type</label>
						<select class="form-select" id="itemType">
							<option value="">Parent Menu Item (No Link)</option>
							<option value="page">Page</option>
							<option value="file">File</option>
							<option value="external">External Link</option>
						</select>
					</div>
					
					<!-- Page Selection (shown when type is 'page') -->
					<div class="mb-3" id="pageSelectionDiv" style="display: none;">
						<label for="itemPageSelect" class="form-label">Select Page <span class="text-danger">*</span></label>
						<select class="form-select" id="itemPageSelect">
							<option value="">Choose a page...</option>
						</select>
					</div>
					
					<!-- File Upload (shown when type is 'file') -->
					<div class="mb-3" id="fileUploadDiv" style="display: none;">
						<label for="itemFileUpload" class="form-label">Upload File <span class="text-danger">*</span></label>
						<div class="input-group">
							<input type="file" class="form-control" id="itemFileUpload" accept="*/*">
							<button type="button" class="btn btn-outline-secondary" id="uploadFileBtn">
								<i class="fa fa-upload"></i> Upload
							</button>
						</div>
						<div class="form-text">Upload a file to the downloads folder</div>
					</div>
					
					<!-- External Link (shown when type is 'external') -->
					<div class="mb-3" id="externalLinkDiv" style="display: none;">
						<label for="itemLink" class="form-label">External URL <span class="text-danger">*</span></label>
						<input type="url" class="form-control" id="itemLink" placeholder="https://example.com">
						<div class="form-text">Enter the full URL (e.g., "https://example.com")</div>
					</div>
					
					<div class="mb-3">
						<label for="itemTitle" class="form-label">Title <span class="text-danger">*</span></label>
						<input type="text" class="form-control" id="itemTitle" required>
					</div>
					
					<div class="mb-3">
						<label for="itemSort" class="form-label">Sort Order</label>
						<input type="number" class="form-control" id="itemSort" value="1" min="1">
					</div>
					
					<div class="mb-3">
						<div class="form-check">
							<input class="form-check-input" type="checkbox" id="itemActive" checked>
							<label class="form-check-label" for="itemActive">
