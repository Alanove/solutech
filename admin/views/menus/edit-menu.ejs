<!-- BEGIN content area -->
<div class="menu-editing">
	<div class="row">
		<div class="col-xl-12">
			<!-- BEGIN panel -->
			<div class="panel panel-inverse">
				<div class="panel-heading">
					<h4 class="panel-title">Edit Menu: <%= menu.name %></h4>
					<div class="panel-heading-btn">
						<a href="/admin/menus" class="btn btn-xs btn-secondary">
							<i class="fa fa-arrow-left"></i> Back to Menus
						</a>
					</div>
				</div>
				<div class="panel-body">
				<div class="row">
					<div class="col-md-4">
						<!-- Menu Details -->
						<div class="card">
							<div class="card-header">
								<h5 class="card-title mb-0">
									<i class="fa fa-bars me-2"></i>Menu Information
								</h5>
							</div>
							<div class="card-body">
								<form method="POST" action="/admin/menus/<%= menu.id %>/edit">
									<div class="mb-3">
										<label for="name" class="form-label">Menu Name <span class="text-danger">*</span></label>
										<input type="text" class="form-control" id="name" name="name" value="<%= menu.name %>" required>
									</div>
									
									<div class="mb-3">
										<label for="description" class="form-label">Description <span class="text-danger">*</span></label>
										<textarea class="form-control" id="description" name="description" rows="3" required><%= menu.description %></textarea>
									</div>
									
									<div class="d-grid">
										<button type="submit" class="btn btn-primary">
											<i class="fa fa-save me-1"></i> Update Menu
										</button>
									</div>
								</form>
							</div>
						</div>
						
						<!-- Add Menu Item Button -->
						<div class="card mt-3">
							<div class="card-body">
								<div class="d-grid">
									<button type="button" class="btn btn-success" id="addMenuItemBtn">
										<i class="fa fa-plus me-1"></i> Add Menu Item
									</button>
								</div>
							</div>
						</div>
					</div>
					
					<div class="col-md-8">
						<!-- Menu Items -->
						<div class="card">
							<div class="card-header">
								<h5 class="card-title mb-0">
									<i class="fa fa-list me-2"></i>Menu Items
								</h5>
								<div class="card-header-btn">
									<button type="button" class="btn btn-xs btn-outline-secondary" id="expandAll">
										<i class="fa fa-expand"></i> Expand All
									</button>
									<button type="button" class="btn btn-xs btn-outline-secondary" id="collapseAll">
										<i class="fa fa-compress"></i> Collapse All
									</button>
								</div>
							</div>
							<div class="card-body">
								<div id="menuItemsContainer">
									<div class="text-center text-muted py-4" id="noItemsMessage">
										<i class="fa fa-list fa-3x mb-3"></i>
										<h6>No menu items</h6>
										<p>Add your first menu item to get started.</p>
									</div>
									<div id="menuItemsList" style="display: none;"></div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
</div>
<!-- END content area -->

<!-- Edit Menu Item Modal -->
<div class="modal fade" id="editMenuItemModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Edit Menu Item</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<form id="editMenuItemForm">
					<input type="hidden" id="editItemId">
					<div class="mb-3">
						<label for="editItemTitle" class="form-label">Title <span class="text-danger">*</span></label>
						<input type="text" class="form-control" id="editItemTitle" required>
					</div>
					
					<div class="mb-3">
						<label for="editItemType" class="form-label">Type</label>
						<select class="form-select" id="editItemType">
							<option value="">Parent Menu Item (No Link)</option>
							<option value="page">Page</option>
							<option value="file">File</option>
							<option value="external">External Link</option>
						</select>
					</div>
					
					<!-- Page Selection (shown when type is 'page') -->
					<div class="mb-3" id="editPageSelectionDiv" style="display: none;">
						<label for="editItemPageSelect" class="form-label">Select Page <span class="text-danger">*</span></label>
						<select class="form-select" id="editItemPageSelect">
							<option value="">Choose a page...</option>
						</select>
					</div>
					
					<!-- File Upload (shown when type is 'file') -->
					<div class="mb-3" id="editFileUploadDiv" style="display: none;">
						<label for="editItemFileUpload" class="form-label">Upload File <span class="text-danger">*</span></label>
						<div class="input-group">
							<input type="file" class="form-control" id="editItemFileUpload" accept="*/*">
							<button type="button" class="btn btn-outline-secondary" id="editUploadFileBtn">
								<i class="fa fa-upload"></i> Upload
							</button>
						</div>
						<div class="form-text">Upload a file to the downloads folder</div>
					</div>
					
					<!-- External Link (shown when type is 'external') -->
					<div class="mb-3" id="editExternalLinkDiv" style="display: none;">
						<label for="editItemLink" class="form-label">External URL <span class="text-danger">*</span></label>
						<input type="url" class="form-control" id="editItemLink" placeholder="https://example.com">
						<div class="form-text">Enter the full URL (e.g., "https://example.com")</div>
					</div>
					
					<div class="mb-3">
						<label for="editItemSort" class="form-label">Sort Order</label>
						<input type="number" class="form-control" id="editItemSort" min="1">
					</div>
					
					<div class="mb-3">
						<div class="form-check">
							<input class="form-check-input" type="checkbox" id="editItemActive" checked>
							<label class="form-check-label" for="editItemActive">
								Active
							</label>
						</div>
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary" id="saveEditItem">Save Changes</button>
			</div>
		</div>
	</div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteItemModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Delete Menu Item</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<p>Are you sure you want to delete the menu item "<strong id="deleteItemName"></strong>"?</p>
				<p class="text-danger"><small>This action cannot be undone. All child items will also be deleted.</small></p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-danger" id="confirmDeleteItem">Delete Item</button>
			</div>
		</div>
	</div>
</div>

<!-- File Upload Modal -->
<div class="modal fade" id="fileUploadModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Upload File</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<div class="mb-3">
					<label for="modalFileUpload" class="form-label">Select File <span class="text-danger">*</span></label>
					<input type="file" class="form-control" id="modalFileUpload" accept="*/*">
				</div>
				<div class="mb-3">
					<label for="modalFileName" class="form-label">File Name (Optional)</label>
					<input type="text" class="form-control" id="modalFileName" placeholder="Leave empty to use original filename">
				</div>
				<div class="alert alert-info">
					<small>
						<i class="fa fa-info-circle"></i>
						Files will be uploaded to the downloads folder and can be accessed via /downloads/filename
					</small>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary" id="confirmFileUpload">Upload File</button>
			</div>
		</div>
	</div>
</div>

<!-- Add Menu Item Modal -->
