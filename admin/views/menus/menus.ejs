<!-- BEGIN content area -->
<div class="menu-editing">
	<div class="row">
		<div class="col-xl-12">
			<!-- BEGIN panel -->
			<div class="panel panel-inverse">
				<div class="panel-heading">
					<h4 class="panel-title">Menu Management</h4>
					<div class="panel-heading-btn">
						<a href="/admin/menus/create" class="btn btn-xs btn-success">
							<i class="fa fa-plus"></i> Add New Menu
						</a>
					</div>
				</div>
				<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong>Success!</strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>

				<!-- BEGIN statistics -->
				<div class="row mb-4">
					<div class="col-md-4">
						<div class="card bg-primary text-white">
							<div class="card-body">
								<div class="d-flex justify-content-between">
									<div>
										<h4 class="mb-0"><%= statistics.totalMenus %></h4>
										<p class="mb-0">Total Menus</p>
									</div>
									<div class="align-self-center">
										<i class="fa fa-bars fa-2x"></i>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="card bg-success text-white">
							<div class="card-body">
								<div class="d-flex justify-content-between">
									<div>
										<h4 class="mb-0"><%= statistics.totalItems %></h4>
										<p class="mb-0">Total Menu Items</p>
									</div>
									<div class="align-self-center">
										<i class="fa fa-list fa-2x"></i>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="card bg-info text-white">
							<div class="card-body">
								<div class="d-flex justify-content-between">
									<div>
										<h4 class="mb-0"><%= menus.length %></h4>
										<p class="mb-0">Active Menus</p>
									</div>
									<div class="align-self-center">
										<i class="fa fa-check-circle fa-2x"></i>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- END statistics -->
				
				<!-- BEGIN filters -->
				<div class="row mb-3">
					<div class="col-md-6">
						<div class="input-group">
							<span class="input-group-text">
								<i class="fa fa-search"></i>
							</span>
							<input type="text" class="form-control" id="keywordFilter" placeholder="Search by menu name or description..." />
						</div>
					</div>
					<div class="col-md-3">
						<button type="button" class="btn btn-secondary" id="clearFilters">
							<i class="fa fa-times me-1"></i> Clear Filters
						</button>
					</div>
				</div>
				<!-- END filters -->
				
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th>Menu Name</th>
								<th>Description</th>
								<th>Items Count</th>
								<th>Last Updated</th>
								<th width="1%">Actions</th>
							</tr>
						</thead>
						<tbody>
							<% if (typeof menus !== 'undefined' && menus && menus.length > 0) { %>
								<% menus.forEach(menu => { %>
									<tr data-menu-id="<%= menu.id %>">
										<td>
											<div class="d-flex align-items-center">
												<div class="flex-grow-1">
													<div class="fw-bold"><%= menu.name %></div>
													<div class="fs-12px text-gray-500-darker">ID: <%= menu.id %></div>
												</div>
											</div>
										</td>
										<td>
											<%= menu.description %>
										</td>
										<td>
											<span class="badge bg-primary"><%= menu.items.length %> items</span>
										</td>
										<td>
											<small class="text-muted">Just now</small>
										</td>
										<td>
											<div class="btn-group">
												<a href="/admin/menus/<%= menu.id %>/edit" class="btn btn-xs btn-primary" title="Edit Menu">
													<i class="fa fa-edit"></i>
												</a>
												<button type="button" class="btn btn-xs btn-danger delete-menu" data-menu-id="<%= menu.id %>" data-menu-name="<%= menu.name %>" title="Delete Menu">
													<i class="fa fa-trash"></i>
												</button>
											</div>
										</td>
									</tr>
								<% }); %>
							<% } else { %>
								<tr>
									<td colspan="5" class="text-center py-4">
										<div class="text-muted">
											<i class="fa fa-bars fa-3x mb-3"></i>
											<h5>No menus found</h5>
											<p>Create your first menu to get started.</p>
											<a href="/admin/menus/create" class="btn btn-primary">
												<i class="fa fa-plus"></i> Create Menu
											</a>
										</div>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
			</div>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
</div>
<!-- END content area -->

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteMenuModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Delete Menu</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<p>Are you sure you want to delete the menu "<strong id="deleteMenuName"></strong>"?</p>
				<p class="text-danger"><small>This action cannot be undone. All menu items will also be deleted.</small></p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-danger" id="confirmDeleteMenu">Delete Menu</button>
			</div>
		</div>
	</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
	// Filter functionality
	const keywordFilter = document.getElementById('keywordFilter');
	const clearFilters = document.getElementById('clearFilters');
	const tableRows = document.querySelectorAll('tbody tr');

	function filterTable() {
		const keyword = keywordFilter.value.toLowerCase();
		
		tableRows.forEach(row => {
			const menuName = row.querySelector('td:first-child .fw-bold').textContent.toLowerCase();
			const description = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
			
			if (menuName.includes(keyword) || description.includes(keyword)) {
				row.style.display = '';
			} else {
				row.style.display = 'none';
			}
		});
	}

	keywordFilter.addEventListener('input', filterTable);
	
	clearFilters.addEventListener('click', function() {
		keywordFilter.value = '';
		filterTable();
	});

	// Delete menu functionality
	const deleteButtons = document.querySelectorAll('.delete-menu');
	const deleteModal = new bootstrap.Modal(document.getElementById('deleteMenuModal'));
	const deleteMenuName = document.getElementById('deleteMenuName');
	const confirmDeleteBtn = document.getElementById('confirmDeleteMenu');
	let menuToDelete = null;

	deleteButtons.forEach(button => {
		button.addEventListener('click', function() {
			menuToDelete = this.dataset.menuId;
			deleteMenuName.textContent = this.dataset.menuName;
			deleteModal.show();
		});
	});

	confirmDeleteBtn.addEventListener('click', function() {
		if (menuToDelete) {
			fetch(`/admin/menus/${menuToDelete}`, {
				method: 'DELETE',
				headers: {
					'Content-Type': 'application/json'
				}
			})
			.then(response => {
				if (response.ok) {
					window.location.reload();
				} else {
					showToast({ message: 'Failed to delete menu', type: 'error' });
				}
			})
			.catch(error => {
				console.error('Error:', error);
				showToast({ message: 'Failed to delete menu', type: 'error' });
			});
		}
		deleteModal.hide();
	});
});
</script>
