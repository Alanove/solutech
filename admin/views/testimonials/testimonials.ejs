<div class="row">
	<div class="col-xl-12">
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title">Testimonials</h4>
				<div class="panel-heading-btn">
					<a href="/admin/testimonials/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> Add Testimonial
					</a>
				</div>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success"><%= success %></div>
				<% } %>
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger"><%= error %></div>
				<% } %>
				<div class="table-responsive">
					<table class="table table-striped align-middle">
						<thead>
							<tr>
								<th>Name</th>
								<th>Quote</th>
								<th>Location</th>
								<th>Sort</th>
								<th>Status</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							<% items.forEach(function(item) { %>
							<tr>
								<td><%= item.name %></td>
								<td><%= (item.quote || '').substring(0, 140) %><%= (item.quote || '').length > 140 ? '…' : '' %></td>
								<td><%= item.location || '—' %></td>
								<td><%= item.sort %></td>
								<td><%= item.status %></td>
								<td class="text-nowrap">
									<a class="btn btn-sm btn-primary" href="/admin/testimonials/<%= item.id %>/edit">Edit</a>
									<button class="btn btn-sm btn-danger" type="button" onclick="deleteItem('<%= item.id %>')">Delete</button>
								</td>
							</tr>
							<% }); %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<script>
	function deleteItem(id) {
		if (!confirm('Delete this testimonial?')) return;
		fetch('/admin/testimonials/' + id, { method: 'DELETE' }).then(function () {
			window.location.reload();
		});
	}
</script>
