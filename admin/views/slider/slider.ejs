<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title">Home Page Slider Management</h4>
				<div class="panel-heading-btn">
					<a href="/admin/slider/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> Add New Slide
					</a>
				</div>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong>Success!</strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<!-- BEGIN filters -->
				<div class="row mb-3">
					<div class="col-md-6">
						<div class="input-group">
							<span class="input-group-text">
								<i class="fa fa-search"></i>
							</span>
							<input type="text" class="form-control" id="keywordFilter" placeholder="Search by alt text..." />
						</div>
					</div>
					<div class="col-md-3">
						<select class="form-select" id="statusFilter">
							<option value="">All Status</option>
							<option value="active">Active</option>
							<option value="inactive">Inactive</option>
						</select>
					</div>
					<div class="col-md-3">
						<button type="button" class="btn btn-secondary" id="clearFilters">
							<i class="fa fa-times me-1"></i> Clear Filters
						</button>
					</div>
				</div>
				<!-- END filters -->
				
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th width="120">Image</th>
								<th class="sortable" data-sort="alt">
									Alt Text <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="title">
									Title <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="order">
									Order <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="status">
									Status <i class="fa fa-sort"></i>
								</th>
								<th>Link & Button</th>
								<th width="200">Actions</th>
							</tr>
						</thead>
						<tbody>
							<% if (typeof slides !== 'undefined' && slides && slides.length > 0) { %>
								<% slides.forEach(slide => { %>
									<tr data-slide-id="<%= slide.id %>" data-status="<%= slide.active ? 'active' : 'inactive' %>">
										<td>
											<img src="<%= slide.image && slide.image.startsWith('/') ? slide.image : '/images/slide/' + slide.image %>" alt="<%= slide.alt %>" class="rounded" width="80" height="60" style="object-fit:cover;" />
										</td>
										<td>
											<div class="d-flex align-items-center">
												<div class="flex-grow-1">
													<div class="fw-bold"><%= slide.alt %></div>
													<div class="fs-12px text-gray-500-darker"><%= slide.image %></div>
												</div>
											</div>
										</td>
										<td>
											<% if (slide.title) { %>
												<div class="fw-bold"><%= slide.title %></div>
											<% } else { %>
												<span class="text-muted">No Title</span>
											<% } %>
										</td>
										<td>
											<span class="badge bg-primary"><%= slide.order %></span>
										</td>
										<td>
											<% if (slide.active) { %>
												<span class="badge bg-success">Active</span>
											<% } else { %>
												<span class="badge bg-secondary">Inactive</span>
											<% } %>
										</td>
										<td>
											<% if (slide.link) { %>
												<div class="mb-1">
													<a href="<%= slide.link %>" target="_blank" class="text-primary" title="View Link">
														<i class="fa fa-external-link-alt"></i> <%= slide.link %>
													</a>
												</div>
												<% if (slide.buttonText) { %>
													<div class="fs-12px text-gray-500-darker">
														Button: "<%= slide.buttonText %>"
													</div>
												<% } %>
											<% } else { %>
												<span class="text-muted">No Link</span>
											<% } %>
										</td>
										<td>
											<div class="btn-group" role="group">
												<a href="/admin/slider/<%= slide.id %>/edit" class="btn btn-xs btn-primary" title="Edit">
													<i class="fa fa-edit"></i>
												</a>
												<a href="/admin/slider/<%= slide.id %>/move-up" class="btn btn-xs btn-info" title="Move Up">
													<i class="fa fa-arrow-up"></i>
												</a>
												<a href="/admin/slider/<%= slide.id %>/move-down" class="btn btn-xs btn-info" title="Move Down">
													<i class="fa fa-arrow-down"></i>
												</a>
												<a href="/admin/slider/<%= slide.id %>/toggle-active" class="btn btn-xs btn-warning" title="Toggle Status">
													<i class="fa fa-toggle-on"></i>
												</a>
												<button type="button" class="btn btn-xs btn-danger delete-slide" data-slide-id="<%= slide.id %>" title="Delete">
													<i class="fa fa-trash"></i>
												</button>
											</div>
										</td>
									</tr>
								<% }); %>
							<% } else { %>
								<tr>
									<td colspan="6" class="text-center py-4">
										<div class="text-muted">
											<i class="fa fa-images fa-3x mb-3"></i>
											<h5>No slides found</h5>
											<p>Get started by adding your first slide to the home page slider.</p>
											<a href="/admin/slider/create" class="btn btn-primary">
												<i class="fa fa-plus me-1"></i> Add First Slide
											</a>
										</div>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteSlideModal" tabindex="-1" aria-labelledby="deleteSlideModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="deleteSlideModalLabel">Confirm Delete</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p>Are you sure you want to delete this slide? This action cannot be undone.</p>
				<p class="text-danger"><strong>Note:</strong> The image file will also be permanently deleted.</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-danger" id="confirmDeleteSlide">Delete Slide</button>
			</div>
		</div>
	</div>
</div> 