<!-- BEGIN breadcrumb -->
<ol class="breadcrumb">
	<li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
	<li class="breadcrumb-item"><a href="/admin/users">Users</a></li>
	<li class="breadcrumb-item active"><%= isCreateMode ? 'Create User' : 'Edit User' %></li>
</ol>
<!-- END breadcrumb -->

<form method="POST" action="<%= isCreateMode ? '/admin/users/create' : '/admin/users/' + user.id + '/edit' %>" id="userForm" data-create-mode="<%= isCreateMode %>">
	<div class="row">
		<!-- BEGIN col-9 -->
		<div class="col-xl-9">
			<div class="panel panel-inverse">
				<div class="panel-heading">
					<h4 class="panel-title">User Information</h4>
				</div>
				<div class="panel-body">
					<% if (typeof error !== 'undefined' && error) { %>
						<div class="alert alert-danger">
							<i class="fa fa-exclamation-triangle"></i> <%= error %>
						</div>
					<% } %>
					<% if (typeof success !== 'undefined' && success) { %>
						<div class="alert alert-success">
							<i class="fa fa-check-circle"></i> <%= success %>
						</div>
					<% } %>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Full Name <span class="text-danger">*</span></label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="name" name="name" value="<%= user && user.name ? user.name : '' %>" required />
							<small class="fs-12px text-gray-500-darker">Enter the user's full name as it should appear in the system.</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Email Address <span class="text-danger">*</span></label>
						<div class="col-md-9">
							<input type="email" class="form-control" id="email" name="email" value="<%= user && user.email ? user.email : '' %>" required <%= isCreateMode ? '' : 'readonly' %> />
							<small class="fs-12px text-gray-500-darker">This will be used for login and notifications.</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Password <% if (isCreateMode) { %><span class="text-danger">*</span><% } %></label>
						<div class="col-md-9">
							<input type="password" class="form-control" id="password" name="password" <%= isCreateMode ? 'required' : '' %> placeholder="<%= isCreateMode ? 'Enter password' : 'Leave blank to keep current password' %>" />
							<small class="fs-12px text-gray-500-darker">Minimum 6 characters. <%= isCreateMode ? '' : 'Leave blank to keep current password.' %></small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Confirm Password <% if (isCreateMode) { %><span class="text-danger">*</span><% } %></label>
						<div class="col-md-9">
							<input type="password" class="form-control" id="confirmPassword" name="confirmPassword" <%= isCreateMode ? 'required' : '' %> placeholder="<%= isCreateMode ? 'Confirm password' : 'Leave blank to keep current password' %>" />
							<small class="fs-12px text-gray-500-darker">Re-enter the password to confirm.</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Notes</label>
						<div class="col-md-9">
							<textarea class="form-control" id="notes" name="notes" rows="3" placeholder="Optional notes about this user"><%= user && user.notes ? user.notes : '' %></textarea>
							<small class="fs-12px text-gray-500-darker">Any additional information about this user.</small>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- END col-9 -->

		<!-- BEGIN col-3 -->
		<div class="col-xl-3">
			<div class="panel panel-inverse">
				<div class="panel-heading">
					<h4 class="panel-title">User Status</h4>
				</div>
				<div class="panel-body">
					<div class="mb-15px">
						<label class="form-label">Status</label>
						<select class="form-select" id="status" name="status" required>
							<option value="Active" <%= user && user.status === 'Active' ? 'selected' : '' %>>Active</option>
							<option value="Inactive" <%= user && user.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
						</select>
						<small class="fs-12px text-gray-500-darker">Set the user's account status.</small>
					</div>
				</div>
			</div>
		</div>
		<!-- END col-3 -->
	</div>
	<!-- END row -->

	<div class="d-flex justify-content-between mt-4">
		<a href="/admin/users" class="btn btn-secondary">
			<i class="fa fa-arrow-left me-1"></i> Back to Users
		</a>
		<button type="submit" class="btn btn-primary">
			<i class="fa fa-save me-1"></i> <%= isCreateMode ? 'Create User' : 'Update User' %>
		</button>
	</div>
</form>

<script>
// Add any custom JS for validation or interactivity here if needed
</script> 