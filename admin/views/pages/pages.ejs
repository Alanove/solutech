<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title">Pages Management</h4>
				<div class="panel-heading-btn">
					<a href="/admin/pages/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> Add New Page
					</a>
				</div>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong>Success!</strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<!-- BEGIN filters -->
				<div class="row mb-3">
					<div class="col-md-6">
						<div class="input-group">
							<span class="input-group-text">
								<i class="fa fa-search"></i>
							</span>
							<input type="text" class="form-control" id="keywordFilter" placeholder="Search by title, key, or URL..." />
						</div>
					</div>
					<div class="col-md-3">
						<select class="form-select" id="statusFilter">
							<option value="">All Status</option>
							<option value="published">Published</option>
							<option value="draft">Draft</option>
						</select>
					</div>
					<div class="col-md-3">
						<button type="button" class="btn btn-secondary" id="clearFilters">
							<i class="fa fa-times me-1"></i> Clear Filters
						</button>
					</div>
				</div>
				<!-- END filters -->
				
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th>Image</th>
								<th class="sortable" data-sort="title">
									Title <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="key">
									Key <i class="fa fa-sort"></i>
								</th>
								<th>URL</th>
								<th class="sortable" data-sort="status">
									Status <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="lastUpdated">
									Last Updated <i class="fa fa-sort"></i>
								</th>
								<th width="1%">Actions</th>
							</tr>
						</thead>
						<tbody>
							<% if (typeof pages !== 'undefined' && pages && pages.length > 0) { %>
								<% pages.forEach(page => { %>
									<tr data-page-id="<%= page.key %>">
										<td>
											<% 
											// Check if pageImage exists and is a valid non-empty string
											const hasValidImage = page.pageImage && 
												typeof page.pageImage === 'string' && 
												page.pageImage.trim() !== '';
											%>
											<% if (hasValidImage) { %>
												<img src="<%= page.pageImage %>" alt="Page Image" class="rounded" width="40" height="40" style="object-fit:cover;" />
											<% } else { %>
												<div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
													<i class="fa fa-image text-muted"></i>
												</div>
											<% } %>
										</td>
										<td>
											<div class="d-flex align-items-center">
												<div class="flex-grow-1">
													<div class="fw-bold"><%= page.title %></div>
													<% if (page.seo?.pageTitle) { %>
														<div class="fs-12px text-gray-500-darker"><%= page.seo.pageTitle %></div>
													<% } %>
												</div>
											</div>
										</td>
										<td><code><%= page.key %></code></td>
										<td>
											<a href="<%= page.url %>" class="page-url" target="_blank">
												<%= page.url %>
											</a>
										</td>
										<td>
											<% if (page.status === 'published') { %>
												<span class="badge bg-success">Published</span>
											<% } else { %>
												<span class="badge bg-secondary">Draft</span>
											<% } %>
										</td>
										<td>
											<% if (page.lastUpdated) { %>
												<%= new Date(page.lastUpdated).toLocaleDateString() %>
											<% } else { %>
												-
											<% } %>
										</td>
										<td>
											<div class="btn-group">
												<a href="/admin/pages/<%= page.key %>/edit" class="btn btn-sm btn-primary">
													<i class="fa fa-edit"></i>
												</a>
												<button type="button" class="btn btn-sm btn-danger" onclick="deleteItem('/admin/pages/<%= page.key %>', this)">
													<i class="fa fa-trash"></i>
												</button>
											</div>
										</td>
									</tr>
								<% }) %>
							<% } else { %>
								<tr>
									<td colspan="7" class="text-center text-muted py-4">
										<i class="fa fa-file-text fa-3x mb-3"></i>
										<h5>No Pages Found</h5>
										<p>Get started by creating your first page.</p>
										<a href="/admin/pages/create" class="btn btn-success">
											<i class="fa fa-plus"></i> Add New Page
										</a>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->

<!-- BEGIN delete confirmation modal -->
<div class="modal fade delete-modal" id="deleteModal" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">
					<i class="fa fa-exclamation-triangle me-2"></i>
					Confirm Page Deletion
				</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<div class="warning-icon">
					<i class="fa fa-exclamation-triangle"></i>
				</div>
				<h5>Are you sure you want to delete this page?</h5>
				<p>This action cannot be undone. The page will be permanently removed from the system.</p>
				
				<div class="page-info">
					<div class="page-title" id="deletePageTitle"></div>
					<div class="page-url" id="deletePageUrl"></div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-cancel" data-bs-dismiss="modal">
					<i class="fa fa-times me-1"></i> Cancel
				</button>
				<form id="deleteForm" method="POST" style="display: inline;">
					<button type="submit" class="btn btn-delete" id="deleteConfirmBtn">
						<i class="fa fa-trash me-1"></i> Delete Page
					</button>
				</form>
			</div>
		</div>
	</div>
</div>
<!-- END delete confirmation modal -->

<!-- BEGIN page-js -->
<script>
	// Sorting functionality
	document.addEventListener('DOMContentLoaded', function() {
		const sortableHeaders = document.querySelectorAll('.sortable');
		let currentSort = { column: null, direction: 'asc' };
		
		sortableHeaders.forEach(header => {
			header.addEventListener('click', function() {
				const column = this.dataset.sort;
				const table = this.closest('table');
				const tbody = table.querySelector('tbody');
				const rows = Array.from(tbody.querySelectorAll('tr'));
				
				// Remove existing sort indicators
				sortableHeaders.forEach(h => {
					h.classList.remove('sort-asc', 'sort-desc');
					h.querySelector('i').className = 'fa fa-sort';
				});
				
				// Determine sort direction
				if (currentSort.column === column && currentSort.direction === 'asc') {
					currentSort.direction = 'desc';
					this.classList.add('sort-desc');
					this.querySelector('i').className = 'fa fa-sort-desc';
				} else {
					currentSort.direction = 'asc';
					this.classList.add('sort-asc');
					this.querySelector('i').className = 'fa fa-sort-asc';
				}
				
				currentSort.column = column;
				
				// Sort rows
				rows.sort((a, b) => {
					let aValue = a.querySelector(`td:nth-child(${getColumnIndex(column)})`).textContent.trim();
					let bValue = b.querySelector(`td:nth-child(${getColumnIndex(column)})`).textContent.trim();
					
					// Handle special cases
					if (column === 'title') {
						aValue = a.querySelector('.fw-bold').textContent.trim();
						bValue = b.querySelector('.fw-bold').textContent.trim();
					} else if (column === 'status') {
						aValue = aValue === 'Published' ? '1' : '0';
						bValue = bValue === 'Published' ? '1' : '0';
					} else if (column === 'lastUpdated') {
						aValue = aValue === '-' ? '0' : new Date(aValue).getTime();
						bValue = bValue === '-' ? '0' : new Date(bValue).getTime();
					}
					
					if (currentSort.direction === 'asc') {
						return aValue.localeCompare(bValue);
					} else {
						return bValue.localeCompare(aValue);
					}
				});
				
				// Re-append sorted rows
				rows.forEach(row => tbody.appendChild(row));
			});
		});
		
		function getColumnIndex(column) {
			const columnMap = {
				'title': 2,
				'key': 3,
				'status': 5,
				'lastUpdated': 6
			};
			return columnMap[column] || 1;
		}
	});
	
	// Delete confirmation
	function confirmDelete(pageKey, pageTitle, pageUrl) {
		document.getElementById('deletePageTitle').textContent = pageTitle;
		document.getElementById('deletePageUrl').textContent = pageUrl;
		document.getElementById('deleteForm').action = `/admin/pages/${pageKey}`;
		
		const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
		deleteModal.show();
	}
	
	// Auto-hide alerts after 5 seconds
	document.addEventListener('DOMContentLoaded', function() {
		const alerts = document.querySelectorAll('.alert');
		alerts.forEach(alert => {
			setTimeout(() => {
				const bsAlert = new bootstrap.Alert(alert);
				bsAlert.close();
			}, 5000);
		});
	});
	
	// Filtering functionality
	document.addEventListener('DOMContentLoaded', function() {
		const keywordFilter = document.getElementById('keywordFilter');
		const statusFilter = document.getElementById('statusFilter');
		const clearFiltersBtn = document.getElementById('clearFilters');
		const table = document.querySelector('table');
		const tbody = table.querySelector('tbody');
		const rows = Array.from(tbody.querySelectorAll('tr'));
		
		// Function to apply filters
		function applyFilters() {
			const keyword = keywordFilter.value.toLowerCase().trim();
			const status = statusFilter.value.toLowerCase();
			
			rows.forEach(row => {
				if (row.querySelector('td[colspan]')) return; // Skip "no pages found" row
				
				const title = row.querySelector('.fw-bold')?.textContent.toLowerCase() || '';
				const key = row.querySelector('code')?.textContent.toLowerCase() || '';
				const url = row.querySelector('.page-url')?.textContent.toLowerCase() || '';
				const statusCell = row.querySelector('td:nth-child(5)')?.textContent.toLowerCase() || '';
				
				const matchesKeyword = !keyword || 
					title.includes(keyword) || 
					key.includes(keyword) || 
					url.includes(keyword);
				
				const matchesStatus = !status || statusCell.includes(status);
				
				if (matchesKeyword && matchesStatus) {
					row.style.display = '';
				} else {
					row.style.display = 'none';
				}
			});
			
			// Show/hide "no pages found" message
			const visibleRows = rows.filter(row => 
				!row.querySelector('td[colspan]') && row.style.display !== 'none'
			);
			
			const noPagesRow = tbody.querySelector('tr td[colspan]');
			if (noPagesRow) {
				const noPagesTr = noPagesRow.closest('tr');
				if (visibleRows.length === 0 && (keyword || status)) {
					noPagesTr.style.display = '';
					noPagesTr.querySelector('td').innerHTML = `
						<i class="fa fa-search fa-3x mb-3"></i>
						<h5>No Pages Found</h5>
						<p>No pages match your current filters.</p>
						<button type="button" class="btn btn-secondary" onclick="clearAllFilters()">
							<i class="fa fa-times me-1"></i> Clear Filters
						</button>
					`;
				} else {
					noPagesTr.style.display = 'none';
				}
			}
		}
		
		// Function to clear all filters
		function clearAllFilters() {
			keywordFilter.value = '';
			statusFilter.value = '';
			applyFilters();
		}
		
		// Event listeners
		keywordFilter.addEventListener('input', applyFilters);
		statusFilter.addEventListener('change', applyFilters);
		clearFiltersBtn.addEventListener('click', clearAllFilters);
		
		// Make clearAllFilters available globally
		window.clearAllFilters = clearAllFilters;
	});
</script>
<!-- END page-js --> 