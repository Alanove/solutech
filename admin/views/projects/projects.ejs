<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title">Projects Management</h4>
				<div class="panel-heading-btn">
					<button type="button" class="btn btn-xs btn-warning me-1" onclick="if(confirm('Are you sure you want to reset all priorities? This will reassign priority numbers in increments of 10 based on the current order.')) window.location.href='/admin/projects/normalize-priorities'">
						<i class="fa fa-sort-numeric-down"></i> Reset Priorities
					</button>
					<a href="/admin/projects/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> Add New Project
					</a>
				</div>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong>Success!</strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<!-- BEGIN filters -->
				<div class="row mb-3">
					<div class="col-md-6">
						<div class="input-group">
							<span class="input-group-text">
								<i class="fa fa-search"></i>
							</span>
							<input type="text" class="form-control" id="keywordFilter" placeholder="Search by title or categories..." />
						</div>
					</div>
					<div class="col-md-3">
						<select class="form-select" id="categoryFilter">
							<option value="">All Categories</option>
							<% if (typeof categories !== 'undefined' && categories) { %>
								<% categories.forEach(category => { %>
									<option value="<%= category %>"><%= category %></option>
								<% }) %>
							<% } %>
						</select>
					</div>
					<div class="col-md-3">
						<button type="button" class="btn btn-secondary" id="clearFilters">
							<i class="fa fa-times me-1"></i> Clear Filters
						</button>
					</div>
				</div>
				<!-- END filters -->
				
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th>Image</th>
								<th class="sortable" data-sort="title">
									Title <i class="fa fa-sort"></i>
								</th>
								
								<th class="sortable" data-sort="categories">
									Categories <i class="fa fa-sort"></i>
								</th>
								<th class="sortable text-center" data-sort="priority">
									Priority <i class="fa fa-sort"></i>
								</th>
								<th class="sortable text-center" width="1%">
									Order
								</th>
								<th class="sortable" data-sort="url">
									URL <i class="fa fa-sort"></i>
								</th>
								<th width="1%">Actions</th>
							</tr>
						</thead>
						<tbody>
							<% if (typeof projects !== 'undefined' && projects && projects.length > 0) { %>
								<% projects.forEach((project, index) => { %>
									<tr data-project-id="<%= index %>">
										<td>
											<% if (project.project_image) { %>
												<img src="<%= projectsService.getProjectImagePath(project) %>" alt="Project Image" class="rounded" width="80" height="80" style="object-fit:cover;" />
											<% } else { %>
												<div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
													<i class="fa fa-image text-muted fa-2x"></i>
												</div>
											<% } %>
										</td>
										<td>
											<div class="d-flex align-items-center">
												<div class="flex-grow-1">
													<div class="fw-bold"><%= project.title %></div>
													
												</div>
											</div>
										</td>
										
										<td>
											<% if (project.categories && project.categories.length > 0) { %>
												<% project.categories.forEach(category => { %>
													<span class="badge bg-secondary me-1"><%= category %></span>
												<% }) %>
											<% } else { %>
												<span class="text-muted">No categories</span>
											<% } %>
										</td>
										<td class="text-center">
											<%= (typeof project.priority !== 'undefined') ? project.priority : 1000 %>
										</td>
										<td class="text-center">
											<div class="btn-group">
												<% if (index > 0) { %>
													<a href="/admin/projects/<%= project.originalIndex %>/move-up" class="btn btn-sm btn-secondary" title="Move Up">
														<i class="fa fa-arrow-up"></i>
													</a>
												<% } else { %>
													<button class="btn btn-sm btn-secondary" disabled>
														<i class="fa fa-arrow-up"></i>
													</button>
												<% } %>
												<% if (index < projects.length - 1) { %>
													<a href="/admin/projects/<%= project.originalIndex %>/move-down" class="btn btn-sm btn-secondary" title="Move Down">
														<i class="fa fa-arrow-down"></i>
													</a>
												<% } else { %>
													<button class="btn btn-sm btn-secondary" disabled>
														<i class="fa fa-arrow-down"></i>
													</button>
												<% } %>
											</div>
										</td>
										<td>
											<a href="/projects/<%= project.url %>" class="project-url" target="_blank">
												<%= project.url %>
											</a>
										</td>
										<td>
											<div class="btn-group">
												<a href="/admin/projects/<%= project.originalIndex %>/edit" class="btn btn-sm btn-primary" title="Edit">
													<i class="fa fa-edit"></i>
												</a>
												<button type="button" class="btn btn-sm btn-danger" onclick="deleteItem('/admin/projects/<%= project.originalIndex %>', this, 'Delete Project', 'Are you sure you want to delete this project? This action cannot be undone.')" title="Delete">
													<i class="fa fa-trash"></i>
												</button>
											</div>
										</td>
									</tr>
								<% }) %>
							<% } else { %>
								<tr>
									<td colspan="7" class="text-center text-muted py-4">
										<i class="fa fa-folder fa-3x mb-3"></i>
										<h5>No Projects Found</h5>
										<p>Get started by creating your first project.</p>
										<a href="/admin/projects/create" class="btn btn-success">
											<i class="fa fa-plus"></i> Add New Project
										</a>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->



<!-- BEGIN page-js -->
<script>
	// Sorting functionality
	document.addEventListener('DOMContentLoaded', function() {
		const sortableHeaders = document.querySelectorAll('.sortable');
		let currentSort = { column: null, direction: 'asc' };
		
		sortableHeaders.forEach(header => {
			header.addEventListener('click', function() {
				const column = this.dataset.sort;
				const table = this.closest('table');
				const tbody = table.querySelector('tbody');
				const rows = Array.from(tbody.querySelectorAll('tr'));
				
				// Remove existing sort indicators
				sortableHeaders.forEach(h => {
					h.classList.remove('sort-asc', 'sort-desc');
					h.querySelector('i').className = 'fa fa-sort';
				});
				
				// Determine sort direction
				if (currentSort.column === column && currentSort.direction === 'asc') {
					currentSort.direction = 'desc';
					this.classList.add('sort-desc');
					this.querySelector('i').className = 'fa fa-sort-desc';
				} else {
					currentSort.direction = 'asc';
					this.classList.add('sort-asc');
					this.querySelector('i').className = 'fa fa-sort-asc';
				}
				
				currentSort.column = column;
				
				// Sort rows
				rows.sort((a, b) => {
					let aValue = a.querySelector(`td:nth-child(${getColumnIndex(column)})`).textContent.trim();
					let bValue = b.querySelector(`td:nth-child(${getColumnIndex(column)})`).textContent.trim();
					
					// Handle special cases
					if (column === 'title') {
						aValue = a.querySelector('.fw-bold').textContent.trim();
						bValue = b.querySelector('.fw-bold').textContent.trim();
					} else if (column === 'priority') {
						// Numeric sort for priority
						return currentSort.direction === 'asc' 
							? parseInt(aValue) - parseInt(bValue)
							: parseInt(bValue) - parseInt(aValue);
					}
					
					if (currentSort.direction === 'asc') {
						return aValue.localeCompare(bValue);
					} else {
						return bValue.localeCompare(aValue);
					}
				});
				
				// Re-append sorted rows
				rows.forEach(row => tbody.appendChild(row));
			});
		});
		
		function getColumnIndex(column) {
			const columnMap = {
				'title': 2,
				'categories': 3,
				'priority': 4,
				'url': 5
			};
			return columnMap[column] || 1;
		}
	});
	

	
	// Auto-hide alerts after 5 seconds
	document.addEventListener('DOMContentLoaded', function() {
		const alerts = document.querySelectorAll('.alert');
		alerts.forEach(alert => {
			setTimeout(() => {
				const bsAlert = new bootstrap.Alert(alert);
				bsAlert.close();
			}, 5000);
		});
	});
	
	// Filtering functionality
	document.addEventListener('DOMContentLoaded', function() {
		const keywordFilter = document.getElementById('keywordFilter');
		const categoryFilter = document.getElementById('categoryFilter');
		const clearFiltersBtn = document.getElementById('clearFilters');
		const table = document.querySelector('table');
		const tbody = table.querySelector('tbody');
		const rows = Array.from(tbody.querySelectorAll('tr'));
		
		// Function to apply filters
		function applyFilters() {
			const keyword = keywordFilter.value.toLowerCase().trim();
			const category = categoryFilter.value;
			
			rows.forEach(row => {
				if (row.querySelector('td[colspan]')) return; // Skip "no projects found" row
				
				const title = row.querySelector('.fw-bold')?.textContent.toLowerCase() || '';
				const categoryElements = row.querySelectorAll('td:nth-child(3) .badge');
				const categoryTexts = Array.from(categoryElements).map(el => el.textContent.toLowerCase());
				const categoriesText = categoryTexts.join(' ');
				
				const matchesKeyword = !keyword || 
					title.includes(keyword) || 
					categoriesText.includes(keyword);
				
				const matchesCategory = !category || categoryTexts.includes(category.toLowerCase());
				
				if (matchesKeyword && matchesCategory) {
					row.style.display = '';
				} else {
					row.style.display = 'none';
				}
			});
			
			// Show/hide "no projects found" message
			const visibleRows = rows.filter(row => 
				!row.querySelector('td[colspan]') && row.style.display !== 'none'
			);
			
			const noProjectsRow = tbody.querySelector('tr td[colspan]');
			if (noProjectsRow) {
				const noProjectsTr = noProjectsRow.closest('tr');
				if (visibleRows.length === 0 && (keyword || category)) {
					noProjectsTr.style.display = '';
					noProjectsTr.querySelector('td').innerHTML = `
						<i class="fa fa-search fa-3x mb-3"></i>
						<h5>No Projects Found</h5>
						<p>No projects match your current filters.</p>
						<button type="button" class="btn btn-secondary" onclick="clearAllFilters()">
							<i class="fa fa-times me-1"></i> Clear Filters
						</button>
					`;
				} else {
					noProjectsTr.style.display = 'none';
				}
			}
		}
		
		// Function to clear all filters
		function clearAllFilters() {
			keywordFilter.value = '';
			categoryFilter.value = '';
			applyFilters();
		}
		
		// Event listeners
		keywordFilter.addEventListener('input', applyFilters);
		categoryFilter.addEventListener('change', applyFilters);
		clearFiltersBtn.addEventListener('click', clearAllFilters);
		
		// Make clearAllFilters available globally
		window.clearAllFilters = clearAllFilters;
	});
</script>
<!-- END page-js --> 