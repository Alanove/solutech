<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title">Clients Management</h4>
				<div class="panel-heading-btn">
					<a href="/admin/clients/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> Add New Client
					</a>
				</div>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong>Success!</strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				<div class="mb-3">
					<div class="row">
						<div class="col-md-6">
							<div class="input-group">
								<span class="input-group-text"><i class="fa fa-search"></i></span>
								<input type="text" class="form-control" id="clientSearch" placeholder="Search clients..." />
							</div>
						</div>
					</div>
				</div>
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th>Image</th>
								<th>Name</th>
								<th>Actions</th>
								<th>Sort Order</th>
							</tr>
						</thead>
						<tbody>
							<% clients.forEach(function(client) { %>
							<tr>
								<td>
									<% if (client.image) { %>
										<div style="width:100px;height:60px;display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid #ddd;border-radius:4px;padding:2px;">
											<img src="/images/clients/<%= client.image %>" alt="<%= client.name %>" style="max-width:100%;max-height:100%;object-fit:contain;" />
										</div>
									<% } else { %>
										<div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:100px;height:60px;border:1px solid #ddd;">
											<i class="fa fa-image text-muted"></i>
										</div>
									<% } %>
								</td>
								<td><%= client.name %></td>
								<td>
									<div class="btn-group">
										<a href="/admin/clients/edit/<%= client.id %>" class="btn btn-sm btn-primary"><i class="fa fa-edit"></i></a>
										<button type="button" class="btn btn-sm btn-danger" onclick="deleteItem('/admin/clients/<%= client.id %>', this, 'Delete Client', 'Are you sure you want to delete this client?')">
											<i class="fa fa-trash"></i>
										</button>
									</div>
									<span style="margin-left: 8px;">
										<a href="/admin/clients/<%= client.id %>/move-up" class="btn btn-xs btn-info" title="Move Up" style="padding: 2px 6px;">
											<i class="fa fa-arrow-up"></i>
										</a>
										<a href="/admin/clients/<%= client.id %>/move-down" class="btn btn-xs btn-info" title="Move Down" style="padding: 2px 6px;">
											<i class="fa fa-arrow-down"></i>
										</a>
									</span>
								</td>
								<td>
									<span class="badge bg-secondary"><%= client.sortOrder || 0 %></span>
								</td>
							</tr>
							<% }); %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- END content area -->
			<script>
				(function(){
					const input = document.getElementById('clientSearch');
					if(!input) return;
					input.addEventListener('input', function(){
						const term = this.value.toLowerCase();
						document.querySelectorAll('table tbody tr').forEach(tr => {
							const nameCell = tr.querySelector('td:nth-child(2)');
							if(!nameCell) return;
							const txt = nameCell.textContent.toLowerCase();
							tr.style.display = !term || txt.includes(term) ? '' : 'none';
						});
					});
				})();
			</script>
