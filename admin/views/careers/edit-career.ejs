<!-- BEGIN breadcrumb -->
<ol class="breadcrumb">
	<li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
	<li class="breadcrumb-item"><a href="/admin/careers">Careers</a></li>
	<li class="breadcrumb-item active">
		<%= isCreateMode ? 'Create Career' : 'Edit Career' %>
	</li>
</ol>
<!-- END breadcrumb -->

<form method="POST" action="<%= isCreateMode ? '/admin/careers/create' : '/admin/careers/' + career.id + '/edit' %>" id="editCareerForm">
	<!-- BEGIN row -->
	<div class="row">
		<!-- BEGIN col-9 -->
		<div class="col-xl-9">
			<!-- BEGIN panel -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-1">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">Career Information</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<% if (typeof error !=='undefined' && error) { %>
						<div class="alert alert-danger">
							<i class="fa fa-exclamation-triangle"></i>
							<%= error %>
						</div>
					<% } %>
					<% if (typeof success !=='undefined' && success) { %>
						<div class="alert alert-success">
							<i class="fa fa-check-circle"></i>
							<%= success %>
						</div>
					<% } %>

					<!-- Basic Information -->
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">Career Title <span
								class="text-danger">*</span></label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="title" name="title"
								value="<%= career.title %>" required />
							<small class="fs-12px text-gray-500-darker">Display title for the career position</small>
						</div>
					</div>

					<div class="row mb-15px">
						<div class="col-12">
							<label class="form-label">Career Description <span class="text-danger">*</span></label>
							<textarea class="form-control rich-text" id="content" name="content" rows="8"
								placeholder="Enter the career description in HTML format..."><%= career.content || '' %></textarea>
							<small class="fs-12px text-gray-500-darker">Rich text content for the career description.
								Use the toolbar above to format your text, add links, images, and
								more.</small>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->
		</div>
		<!-- END col-9 -->
		
		<!-- BEGIN col-3 -->
		<div class="col-xl-3">
			<!-- BEGIN panel -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-2">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">Actions</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<div class="mb-3">
						<label class="form-label">Status</label>
						<select class="form-select" id="status" name="status">
							<option value="draft" <%= career.status === 'draft' ? 'selected' : '' %>>Draft</option>
							<option value="published" <%= career.status === 'published' ? 'selected' : '' %>>Published</option>
						</select>
						<small class="fs-12px text-gray-500-darker d-block mt-1">Published careers will appear on the public website</small>
					</div>
					<button type="submit" class="btn btn-success w-100 mb-2">
						<i class="fa fa-save"></i> <%= isCreateMode ? 'Create Career' : 'Update Career' %>
					</button>
					<a href="/admin/careers" class="btn btn-secondary w-100">
						<i class="fa fa-times"></i> Cancel
					</a>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->
		</div>
		<!-- END col-3 -->
	</div>
	<!-- END row -->
</form>

