<div class="panel panel-inverse">
  <div class="panel-heading"><h4 class="panel-title"><%= pageTitle %></h4></div>
  <div class="panel-body">
    <form method="post" action="/admin/product-categories/save" enctype="multipart/form-data">
      <div class="mb-3"><label>Name</label><input class="form-control" name="name" value="<%= category ? category.name : '' %>" required></div>
      <div class="mb-3"><label>Slug</label><input class="form-control" name="slug" value="<%= category ? category.slug : '' %>" <%= category ? 'readonly' : '' %>></div>
      <div class="mb-3"><label>Description</label><textarea class="form-control" name="description" rows="4"><%= category ? (category.description || '') : '' %></textarea></div>
      <div class="mb-3">
        <label class="form-label">Picture</label>
        <% if (category && category.image) { %>
          <div class="mb-2"><img src="<%= category.image %>" alt="" style="max-height:160px"></div>
          <label class="form-check"><input type="checkbox" name="removeImage" value="1"> Remove picture</label>
        <% } %>
        <input class="form-control" type="file" name="imageFile" accept="image/*">
      </div>
      <div class="mb-3"><label>Sort</label><input class="form-control" name="sort" value="<%= category ? (category.sort || 0) : 0 %>"></div>
      <div class="mb-3">
        <label class="form-check">
          <input type="checkbox" class="form-check-input" name="showOnHome" value="1" <%= !category || category.showOnHome !== false ? 'checked' : '' %>>
          Show on home page
        </label>
        <small class="text-muted d-block">Home page cards use this category's picture, name and sort order.</small>
      </div>
      <div class="mb-3">
        <label class="form-check">
          <input type="checkbox" class="form-check-input" name="status" value="hidden" <%= category && category.status === 'hidden' ? 'checked' : '' %>>
          Hidden (not shown on public site)
        </label>
      </div>
      <button class="btn btn-primary" type="submit">Save</button>
      <a class="btn btn-secondary" href="/admin/product-categories">Cancel</a>
    </form>
  </div>
</div>
