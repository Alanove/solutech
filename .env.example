# Local dev: edit `.env.development` (or copy this file to `.env`).
# npm run dev loads: .env → .env.development → .env.local
# Production: set values in `.env.production` or your host environment.

# Form email (SMTP required for messages to reach contactEmail in Admin → Site Settings)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@bluefieldco.com
