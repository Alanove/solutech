<!-- Fullscreen Menu -->
<div class="fullscreen-menu" id="fullscreenMenu">
  <!-- Fullscreen Burger Menu (same design as header) -->
  <button class="fullscreen-burger-menu" id="fullscreenCloseBtn" aria-label="Close menu">
    <span class="burger-line"></span>
    <span class="burger-line"></span>
    <span class="burger-line"></span>
  </button>
  
  <!-- Animated Menu Container -->
  <div class="fullscreen-menu-container">
    <div class="menu-content">
      <ul>
        <% if (typeof items !== 'undefined' && items && items.length > 0) { %>
          <% items.forEach(function(item) { %> 
            <% if (item.active) { %>
              <li class="menu-item<%= item.children && item.children.length > 0 ? ' has-submenu' : '' %>">
                <a
                  href="<%= item.url %>"
                  class="<%= selected === item.key ? 'active' : '' %>"
                  <% if (item.children && item.children.length > 0) { %>
                    data-submenu="<%= item.id %>"
                  <% } %>
                >
                  <%= item.title %>
                </a>
                <% if (item.children && item.children.length > 0) { %>
                  <ul class="submenu">
                    <% item.children.forEach(function(subItem) { %>
                      <% if (subItem.active) { %>
                        <li>
                          <a
                            href="<%= subItem.url %>"
                            class="<%= selected === subItem.key ? 'active' : '' %>"
                          >
                            <%= subItem.title %>
                          </a>
                        </li>
                      <% } %>
                    <% }); %>
                  </ul>
                <% } %>
              </li>
            <% } %>
          <% }); %>
        <% } %>
      </ul>
    </div>
  </div>
</div>
