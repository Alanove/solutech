<aside class="solu-cats">
  <h2>Categories</h2>
  <ul>
    <% (typeof categories !== 'undefined' ? categories : []).forEach(function(item) { %>
      <li><a href="/product-category/<%= item.slug %>"><%= item.name %><% if (typeof item.count === 'number') { %> <%= item.count %><% } %></a></li>
    <% }) %>
  </ul>
</aside>
