<% if (typeof pageContent !== 'undefined' && pageContent) { %><%- pageContent %><% } %>
<script>
(function () {
  var form = document.getElementById('contact-form');
  if (!form) return;
  form.addEventListener('submit', async function (event) {
    event.preventDefault();
    var status = form.querySelector('.solu-form-status');
    var data = Object.fromEntries(new FormData(form).entries());
    var response = await fetch('/api/forms/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: data['your-name'] || '',
        company: data.company || '',
        email: data.mail || '',
        phone: data.phone || '',
        message: data.Help || ''
      })
    });
    var result = await response.json().catch(function () { return {}; });
    if (status) {
      status.hidden = false;
      status.setAttribute('aria-hidden', 'false');
      status.textContent = result.message || (response.ok ? 'Thank you for your message. It has been sent.' : 'There was an error trying to send your message. Please try again later.');
    }
  });
})();
</script>
