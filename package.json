{
  "name": "solutec-cms",
  "version": "1.0.0",
  "description": "Solutec site on the Node.js CMS",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/app.js",
    "prod:run": "NODE_ENV=production node dist/src/app.js",
    "prod": "npm run build && npm run prod:run",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:debug": "ts-node-dev --respawn --transpile-only --inspect=9229 src/app.ts",
    "dev:debug-brk": "ts-node-dev --respawn --transpile-only --inspect-brk=9299 ./src/app.ts",
    "start:debug": "node --inspect dist/src/app.js",
    "scss": "npx sass public/css/styles.scss:public/css/styles.css --style=compressed --watch",
    "scss:once": "npx sass public/css/styles.scss:public/css/styles.css --style=compressed",
    "scss-dev": "npx sass public/css/styles.scss:public/css/styles.css --style=expanded --watch",
    "scss-admin": "npx sass admin/public/css/admin.scss:admin/public/css/admin.css --style=compressed --watch",
    "scss-admin-dev": "npx sass admin/public/css/admin.scss:admin/public/css/admin.css --style=expanded --watch",
    "scss-all": "npm run scss && npm run scss-admin",
    "scss-all-dev": "npm run scss-dev && npm run scss-admin-dev",
    "clean": "node scripts/clean.js",
    "prebuild": "npm run clean",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "install:playwright": "playwright install",
    "generate-test-images": "node scripts/generate-test-images.js",
    "clients:ocr": "node scripts/clients-ocr.js",
    "js:build": "node src/scripts/build-script.js"
  },
  "dependencies": {
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "adm-zip": "^0.5.16",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.1",
    "mammoth": "^1.9.1",
    "multer": "^2.0.1",
    "sass": "^1.77.0",
    "nodemailer": "^8.0.7",
    "officegen": "^0.6.5",
    "pptx2json": "^0.0.10",
    "tesseract.js": "^5.0.0-alpha.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^8.0.0",
    "rimraf": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "cms",
    "typescript",
    "nodejs",
    "express"
  ],
  "author": "CMS Project",
  "license": "MIT"
}
